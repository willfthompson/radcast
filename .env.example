# ---- Required ---------------------------------------------------------------------

# The live stream to record. An HLS playlist (.m3u8), an Icecast/Shoutcast URL, or anything
# ffmpeg can open. If the station offers several bitrates, use the URL of ONE variant.
STREAM_URL=https://stream.example.com/live/station-audio=128000.m3u8

# Timezone the timers in shows.yml are written in.
TZ=Europe/Amsterdam

# Public address of this Radcast, as podcast apps will reach it. No trailing slash.
# Raspberry Pi + Tailscale: https://<machine>.<tailnet>.ts.net   VPS + Caddy: https://your.domain
FEED_URL=https://radcast.your-tailnet.ts.net

# ---- Recommended ------------------------------------------------------------------

# Basic auth for the feed, recordings and dashboard. Leave both empty for no password
# (fine inside a private Tailscale network; not fine on the open internet).
FEED_USERNAME=me
FEED_PASSWORD=change-me

# ---- Feed metadata (optional) -----------------------------------------------------

FEED_TITLE=Radcast
FEED_DESCRIPTION=Radio recordings
# FEED_AUTHOR=            defaults to FEED_TITLE
# FEED_LANGUAGE=en
# FEED_CATEGORY=Music
# FEED_EMAIL=             only needed if a directory asks for an owner address
# Cover art: a square JPEG or PNG (1400 to 3000 px). Inside the container this is
# /config/artwork.jpg, i.e. put the file at ./config/artwork.jpg next to shows.yml.
# ARTWORK=/config/artwork.jpg

# ---- Recording (optional) ---------------------------------------------------------

# auto:      copy MP3 and AAC-LC streams as-is (no quality loss), transcode anything else
# copy:      copy MP3 and any AAC as-is, even HE-AAC (which some apps play silent at first)
# transcode: always re-encode to AAC-LC at TRANSCODE_BITRATE
# AUDIO_MODE=auto
# TRANSCODE_BITRATE=128k
# MAX_EPISODES=20         oldest recordings are deleted beyond this
# START_BUFFER=30         seconds to start before the timer
# END_BUFFER=60           seconds to keep going after it

# ---- Hosting (optional) -----------------------------------------------------------

# VPS with Caddy: the hostname Caddy should get a certificate for. Then start with
#   docker compose --profile caddy up -d
# DOMAIN=radcast.your.domain

# User and group the container runs as; must own ./recordings. 1000 is the first user on
# Raspberry Pi OS and most Linux installs. Check yours with: id -u; id -g
# PUID=1000
# PGID=1000
